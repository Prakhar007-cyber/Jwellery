# ÉLANORA — environment variables
# Copy this file to `.env.local` and fill in the values.

# ---------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas or a local MongoDB).
# If left EMPTY, the app boots a disposable in-memory MongoDB in
# development and auto-seeds it — great for a quick zero-config demo.
# For real, persistent data, set a real connection string here.
# ---------------------------------------------------------------
MONGODB_URI=

# ---------------------------------------------------------------
# Auth.js / NextAuth. AUTH_SECRET signs the session JWTs.
# Generate one with:  npx auth secret   (or `openssl rand -base64 32`)
# ---------------------------------------------------------------
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------
# Optional Google OAuth. Leave blank to disable "Continue with Google".
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
